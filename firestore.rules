rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ──────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isSecurity() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'security';
    }

    // ─── Users Collection ──────────────────────────────────────────────
    // Users can read/write only their own document.
    // publicKey can be set by the client on creation or update.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin() || isSecurity();
      allow create: if isOwner(uid) &&
        request.resource.data.keys().hasAll(['email', 'role', 'createdAt']) &&
        request.resource.data.role == 'user';
      allow update: if isOwner(uid) &&
        // Prevent users from escalating their own role
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if false; // Users cannot delete their own document
    }

    // ─── Events Collection ─────────────────────────────────────────────
    // Public read for all authenticated users; write only by admins.
    // Security can also read events for check-in context.
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.organizerId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.organizerId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.organizerId == request.auth.uid;
    }

    // ─── Tickets Collection ────────────────────────────────────────────
    // Create: authenticated user can create ticket with ownerId == uid, status == 'pending'.
    // Read: only ticket owner, admin, or security personnel.
    // Update: admin or security can update check-in fields; Cloud Functions handle activation.
    // Delete: only the event organizer (admin) can delete tickets.
    match /tickets/{ticketId} {
      allow read: if (isAuthenticated() && resource.data.ownerId == request.auth.uid) || isAdmin() || isSecurity();
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.biometricVerified == false &&
        request.resource.data.insideFence == false &&
        request.resource.data.keys().hasAll(['eventId', 'ownerId', 'status', 'biometricVerified', 'insideFence', 'createdAt']);
      // Admin or Security can update check-in fields
      // Admin can also deactivate tickets
      allow update: if isAdmin() || isSecurity();
      // Allow event organizer to delete tickets (for event cleanup)
      allow delete: if isAuthenticated() &&
        get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.organizerId == request.auth.uid;
    }

    // ─── Activation Nonces ─────────────────────────────────────────────
    // Server-only. No client read/write.
    match /activation_nonces/{nonceId} {
      allow read, write: if false;
    }

    // ─── Attendance Logs ───────────────────────────────────────────────
    // Server-only write normally. Admins and security can write for check-ins.
    // Owners can read their own logs (via ticketId lookup).
    match /attendance_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isSecurity();
      allow update, delete: if false;
    }
  }
}
